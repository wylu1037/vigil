{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigil",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BASE_URL": "https://anyrouter.top/v1",
    "MAIL_FROM": "AnyRouter <onboarding@resend.dev>"
  },
  "kv_namespaces": [
    {
      "binding": "VIGIL_STATE",
      "id": "8b1985324cfd4747bd222c224e2d0e78"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vigil",
      "database_id": "e1f38008-7d77-44dd-bb20-3aa24b9f0f80",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
